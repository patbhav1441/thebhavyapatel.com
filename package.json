{
  "name": "thebhavyapatel-com",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:cms": "decap-server",
    "check:astro": "astro check",
    "check:worker": "tsc --noEmit -p workers/cms-auth/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:routes": "tsx scripts/validate-routes.ts",
    "validate:placeholders": "tsx scripts/validate-placeholders.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run format:check && npm run lint && npm run check:astro && npm run check:worker && npm run validate:content && npm run validate:routes && npm run validate:placeholders && npm run test",
    "build": "npm run check && astro build && npm run smoke",
    "smoke": "tsx scripts/smoke-build.ts",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "deploy:auth": "wrangler deploy --config workers/cms-auth/wrangler.jsonc",
    "deploy:auth:dry": "wrangler deploy --dry-run --config workers/cms-auth/wrangler.jsonc",
    "types:worker": "wrangler types --config workers/cms-auth/wrangler.jsonc workers/cms-auth/worker-configuration.d.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "astro": "7.2.2",
    "decap-cms-app": "3.15.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@typescript-eslint/parser": "8.67.0",
    "decap-server": "3.10.0",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "3.1.0",
    "gray-matter": "4.0.3",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
