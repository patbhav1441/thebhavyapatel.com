---
import { getCollection } from "astro:content";
import HomeHero from "@components/home/HomeHero.astro";
import SelectedWork from "@components/home/SelectedWork.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { home, site } from "@lib/settings";

const projects = (await getCollection("projects", ({ data }) => data.published && data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, home.selectedWorkLimit);

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.canonicalUrl,
  sameAs: Object.values(site.socials).filter(Boolean),
};
---

<BaseLayout path="/" structuredData={personJsonLd}>
  <HomeHero />
  <SelectedWork projects={projects} />

  <section class="section" aria-labelledby="focus-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">02 / Current focus</p>
        <div>
          <h2 id="focus-title">What the notebook is open to.</h2>
          <p>Broad interests, narrowed into concrete questions and buildable systems.</p>
        </div>
      </div>
      <div class="focus-grid">
        {
          home.currentFocus.map((focus, index) => (
            <div class="focus-item">
              <>
                <span class="project-code">0{index + 1}</span>
                <h3>{focus}</h3>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="shell section-heading">
      <p class="eyebrow">03 / About</p>
      <div>
        <h2 id="about-title">A builder between disciplines.</h2>
        <p>{home.aboutSummary}</p>
        <p style="margin-top:1.5rem">
          <a class="text-link" href="/about/">Read the working profile →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="closing">{home.closingStatement}</p>
    </div>
  </section>
</BaseLayout>
