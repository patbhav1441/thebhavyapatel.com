    <p>Return to the systems index or continue through the published work.</p>
    <div class="hero-actions">
      <a class="button-link" href="/">Go home</a><a class="button-link secondary" href="/work/"
        >View work</a
      >
    </div>
  </header>
</BaseLayout>
