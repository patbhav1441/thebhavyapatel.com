---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import { formatStatus, projectPagePath, projectPath } from "@lib/routes";

interface Props {
  project: CollectionEntry<"projects">;
  relatedPages: CollectionEntry<"projectPages">[];
  nextProject?: CollectionEntry<"projects">;
}

const { project, relatedPages, nextProject } = Astro.props;
const { data } = project;
const accent = `var(--${data.accent})`;
const title = data.seo.title || `${data.title} — Bhavya Patel`;
---

<BaseLayout
  title={title}
  description={data.seo.description}
  path={projectPath(data.slug)}
  noindex={data.seo.noindex}
  type="article"
>
  <article>
    <header class="project-hero shell">
      <div class="project-hero__meta">
        <span class="project-code">{data.projectCode} / {data.kind}</span>
        <span class="status">{formatStatus(data.status)}</span>
      </div>
      <h1>{data.title}</h1>
      <p class="project-hero__summary">{data.summary}</p>
    </header>
    <div class="project-accent" style={`--project-accent:${accent}`} aria-hidden="true"></div>

    {
      (data.shortProblem || data.shortSolution || data.role) && (
        <section class="section">
          <div class="shell fact-grid">
            {data.shortProblem && (
              <div class="fact">
                <p class="eyebrow">Problem</p>
                <p>{data.shortProblem}</p>
              </div>
            )}
            {data.shortSolution && (
              <div class="fact">
                <p class="eyebrow">Direction</p>
                <p>{data.shortSolution}</p>
              </div>
            )}
            {data.role && (
              <div class="fact">
                <p class="eyebrow">Role</p>
                <p>{data.role}</p>
              </div>
            )}
          </div>
        </section>
      )
    }

    <section class="section">
      <div class="shell prose"><slot /></div>
    </section>

    {
      data.features.length > 0 && (
        <section class="section" aria-labelledby="features-title">
          <div class="shell">
            <div class="section-heading">
              <>
                <p class="eyebrow">System notes</p>
                <h2 id="features-title">Current feature direction</h2>
              </>
            </div>
            <ul class="feature-list">
              {data.features.map((feature) => (
                <li>
                  <h3>{feature.title}</h3>
                  <p>{feature.description}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      (data.technologies.length > 0 || relatedPages.length > 0) && (
        <section class="section">
          <div class="shell fact-grid">
            {data.technologies.length > 0 && (
              <div class="fact">
                <p class="eyebrow">Tools and media</p>
                <p>{data.technologies.join(" · ")}</p>
              </div>
            )}
            {relatedPages.map((page) => (
              <div class="fact">
                <p class="eyebrow">Product document</p>
                <a class="text-link" href={projectPagePath(data.slug, page.data.pageSlug)}>
                  {page.data.title}
                </a>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      nextProject && (
        <section class="section">
          <div class="shell">
            <p class="eyebrow">Next in the index</p>
            <h2>
              <a class="text-link" href={projectPath(nextProject.data.slug)}>
                {nextProject.data.title} →
              </a>
            </h2>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
