{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "allowJs": false,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@components/*": ["./src/components/*"],
      "@data/*": ["./src/data/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@lib/*": ["./src/lib/*"],
      "@styles/*": ["./src/styles/*"]
    },
    "types": ["vite/client"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "bhavya-portfolio", "node_modules"]
}
